{
  "name": "parallelbrowser-client",
  "version": "1.1.1",
  "description": "ParallelBrowser Client - Connect to remote isolated browser",
  "main": "dist/main/index.js",
  "scripts": {
    "build:shared": "cd ../shared && npm run build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node build-renderer.js",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron dist/main/index.js",
    "dev": "npm run build:main && electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@parallelbrowser/shared": "file:../shared",
    "ws": "^8.16.0"
  }
}
